CONFIG_IDF_TARGET="esp32"
CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"
# OTA with automatic rollback (REQ-OTA-2)
CONFIG_BOOTLOADER_APP_ROLLBACK_ENABLE=y
CONFIG_APP_PROJECT_VER_FROM_CONFIG=y
CONFIG_APP_PROJECT_VER="0.2.0"
# Larger main task: settings structs and init on the stack
CONFIG_ESP_MAIN_TASK_STACK_SIZE=4096
# Crash reports: core dump to flash (ELF), summary logged on the next boot
CONFIG_ESP_COREDUMP_ENABLE_TO_FLASH=y
CONFIG_ESP_COREDUMP_DATA_FORMAT_ELF=y
CONFIG_ESP_COREDUMP_CHECKSUM_CRC32=y
# A hung task should also leave a crash report instead of only a warning
CONFIG_ESP_TASK_WDT_PANIC=y
